{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "blog-writer@tomtom87-blog": true
  },
  "extraKnownMarketplaces": {
    "tomtom87-blog": {
      "source": {
        "source": "github",
        "repo": "tomtom87/blog"
      }
    }
  }
}
