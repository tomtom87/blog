---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const { title, description = SITE_DESCRIPTION, type = "website" } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-white text-ink antialiased [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-2 [&_:focus-visible]:outline-accent">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-white focus:px-3 focus:py-2 focus:text-accent focus:ring-2 focus:ring-accent"
    >
      Skip to content
    </a>
    <header class="border-b border-slate-200">
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-4 py-4">
        <a
          href="/"
          class="font-semibold text-ink hover:text-accent hover:underline"
        >
          ~/{SITE_TITLE.toLowerCase().replaceAll(" ", "-")}
        </a>
        <nav aria-label="Main" class="flex gap-4">
          <a
            href="/blog/"
            class="font-semibold text-slate-600 hover:text-accent hover:underline"
          >
            Blog
          </a>
          <a
            href="/about/"
            class="font-semibold text-slate-600 hover:text-accent hover:underline"
          >
            About
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-2xl flex-1 px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-slate-200">
      <p class="mx-auto max-w-2xl px-4 py-6 text-sm text-slate-500">
        {`© ${new Date().getFullYear()} ${SITE_TITLE}`}
      </p>
    </footer>
  </body>
</html>
