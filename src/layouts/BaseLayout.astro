---
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-zinc-950 text-zinc-100 antialiased [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-2 [&_:focus-visible]:outline-accent">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-zinc-900 focus:px-3 focus:py-2 focus:text-accent"
    >
      Skip to content
    </a>
    <header class="border-b border-zinc-800">
      <div class="mx-auto flex max-w-2xl items-center justify-between gap-4 px-4 py-4">
        <a href="/" class="font-mono font-bold text-accent hover:underline">
          ~/{SITE_TITLE.toLowerCase().replaceAll(" ", "-")}
        </a>
        <nav aria-label="Main">
          <a
            href="/blog/"
            class="font-mono text-zinc-300 hover:text-accent hover:underline"
          >
            Blog
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="mx-auto w-full max-w-2xl flex-1 px-4 py-10">
      <slot />
    </main>
    <footer class="border-t border-zinc-800">
      <p class="mx-auto max-w-2xl px-4 py-6 font-mono text-sm text-zinc-400">
        {`© ${new Date().getFullYear()} ${SITE_TITLE}`}
      </p>
    </footer>
  </body>
</html>
