---
import { Font } from "astro:assets";
import "../styles/global.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
}

const { title, description = SITE_DESCRIPTION, type = "website" } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages with a full-bleed hero get a transparent header laid over it.
const overHero = Astro.slots.has("hero");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href="/rss.xml"
    />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta name="twitter:card" content="summary" />
    <Font cssVariable="--font-archivo" preload />
    <Font cssVariable="--font-space-grotesk" preload />
    <title>{pageTitle}</title>
  </head>
  <body class="relative flex min-h-screen flex-col bg-paper font-sans text-fg antialiased [&_:focus-visible]:outline-2 [&_:focus-visible]:outline-offset-2 [&_:focus-visible]:outline-accent">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-30 focus:bg-paper focus:px-3 focus:py-2 focus:text-accent focus:ring-2 focus:ring-accent"
    >
      Skip to content
    </a>
    <header class:list={[overHero ? "absolute inset-x-0 top-0 z-20" : ""]}>
      <div
        class:list={[
          "mx-auto flex max-w-4xl items-center justify-between gap-4 px-4 py-5 sm:px-8",
        ]}
      >
        <a
          href="/"
          class="link-sweep font-display text-lg font-semibold tracking-tight"
        >
          {SITE_TITLE}
        </a>
        <nav aria-label="Main" class="flex gap-5">
          <a
            href="/blog/"
            class:list={[
              "link-sweep py-2 font-medium",
              "text-zinc-300 hover:text-fg",
            ]}
          >
            Blog
          </a>
          <a
            href="/about/"
            class:list={[
              "link-sweep py-2 font-medium",
              "text-zinc-300 hover:text-fg",
            ]}
          >
            About
          </a>
        </nav>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot name="hero" />
      <div class="mx-auto w-full max-w-4xl px-4 py-12 sm:px-8 sm:py-20">
        <slot />
      </div>
    </main>
    <footer class="border-t border-line">
      <p class="mx-auto max-w-4xl px-4 py-8 text-sm text-muted sm:px-8">
        {`© ${new Date().getFullYear()} ${SITE_TITLE}`}
      </p>
    </footer>
  </body>
</html>
