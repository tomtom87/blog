---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../lib/posts";

const recent = (await getPublishedPosts()).slice(0, 5);
---

<BaseLayout>
  <Hero slot="hero" />
  <section class="mt-12" aria-labelledby="recent-posts">
    <h2 id="recent-posts" class="text-xl font-bold tracking-tight text-ink">
      Recent posts
    </h2>
    <div class="mt-6">
      <PostList posts={recent} />
    </div>
    <a
      href="/blog/"
      class="mt-8 inline-block font-medium text-accent hover:underline"
    >
      All posts →
    </a>
  </section>
</BaseLayout>
