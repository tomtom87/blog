---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PostList from "../components/PostList.astro";
import { Image } from "astro:assets";
import introPhoto from "../assets/intro-kleinarl.jpg";
import ReleaseList from "../components/ReleaseList.astro";
import { getCollection } from "astro:content";
import { getPublishedPosts } from "../lib/posts";
import { byNewest } from "../lib/releases";

const recent = (await getPublishedPosts()).slice(0, 5);
const releases = byNewest(await getCollection("releases")).slice(0, 5);
---

<BaseLayout>
  <Hero slot="hero" />
  <section
    id="intro"
    aria-labelledby="intro-heading"
    class="grid gap-10 sm:grid-cols-[1.1fr_1fr] sm:items-end"
  >
    <div>
      <p class="text-sm text-muted">What I do</p>
      <h2 id="intro-heading" class="mt-3 text-3xl sm:text-4xl">
        A small studio for Shopify storefronts and content sites.
      </h2>
      <p class="mt-5 text-zinc-400">
        I help brands plan, design and build fast websites. Replace this with a
        few lines about who you help and how.
      </p>
      <dl class="mt-8 grid grid-cols-[6rem_1fr] gap-x-4 gap-y-2 text-sm">
        <dt class="text-muted">Building</dt>
        <dd>A client storefront on Shopify</dd>
        <dt class="text-muted">Learning</dt>
        <dd>Astro and CSS scroll-driven animations</dd>
        <dt class="text-muted">Reading</dt>
        <dd>A book you'd recommend</dd>
      </dl>
    </div>
    <figure class="overflow-hidden rounded bg-surface">
      <Image
        src={introPhoto}
        alt="Snow-covered peaks at dusk above a chalet with warm lit windows"
        widths={[640, 1024]}
        sizes="(min-width: 640px) 420px, 100vw"
        class="parallax-img aspect-[4/3] w-full object-cover"
      />
    </figure>
  </section>
  <section class="mt-24" aria-labelledby="recent-posts">
    <h2
      id="recent-posts"
      class="text-sm font-normal tracking-normal text-muted"
    >
      Recent writing
    </h2>
    <div class="mt-6">
      <PostList posts={recent} />
    </div>
    <a href="/blog/" class="link-sweep mt-10 inline-block font-medium">
      All posts
    </a>
  </section>
  <section class="mt-24" aria-labelledby="recent-releases">
    <h2
      id="recent-releases"
      class="text-sm font-normal tracking-normal text-muted"
    >
      Recent releases
    </h2>
    <div class="mt-6">
      <ReleaseList releases={releases} />
    </div>
    <a href="/releases/" class="link-sweep mt-10 inline-block font-medium">
      All releases
    </a>
  </section>
  <p class="mt-24 text-xs text-muted">
    Photos:{" "}
    <a
      class="underline hover:text-fg"
      href="https://commons.wikimedia.org/wiki/File:French_alps_at_Lake_Geneva_during_the_blue_hour_with_reflections.jpg"
    >
      French Alps at Lake Geneva
    </a>{" "}
    by Deralpinbergsteiger and{" "}
    <a
      class="underline hover:text-fg"
      href="https://commons.wikimedia.org/wiki/File:Kleinarl_J%C3%A4gersee_20180209.jpg"
    >
      Kleinarl Jägersee
    </a>{" "}
    by Uoaei1, both{" "}
    <a
      class="underline hover:text-fg"
      href="https://creativecommons.org/licenses/by-sa/4.0/"
    >
      CC BY-SA 4.0
    </a>
    , resized.
  </p>
</BaseLayout>
