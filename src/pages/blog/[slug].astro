---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../lib/posts";
import TagList from "../../components/TagList.astro";
import { formatDate } from "../../lib/date";
import { readingTime } from "../../lib/readingTime";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
>
  <article>
    <header>
      <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">
        {post.data.title}
      </h1>
      <p class="mt-2 font-mono text-sm text-slate-500">
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        {` · ${readingTime(post.body ?? "")} min read`}
      </p>
      <TagList tags={post.data.tags} />
    </header>
    <div class="prose mt-8 max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink">
      <Content />
    </div>
  </article>
</BaseLayout>
