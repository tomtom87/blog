---
import type { CollectionEntry } from "astro:content";
import PostMeta from "./PostMeta.astro";
import { formatDate } from "../lib/date";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

<ul class="border-t border-line">
  {posts.map((post) => (
    <li class="post-row grid gap-2 border-b border-line py-8">
      <time datetime={post.data.date.toISOString()} class="text-sm text-muted">
        {formatDate(post.data.date)}
      </time>
      <a
        href={`/blog/${post.id}/`}
        class="post-title font-display text-3xl leading-[1.05] font-semibold tracking-[-0.03em] sm:text-4xl"
      >
        {post.data.title}
      </a>
      <p class="max-w-[52ch] text-zinc-400">{post.data.description}</p>
      <PostMeta post={post} class="mt-1" />
    </li>
  ))}
</ul>
