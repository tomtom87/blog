---
import { tagSlug } from "../lib/tags";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul aria-label="Tags" class="flex flex-wrap gap-x-3 gap-y-1">
    {tags.map((tag) => (
      <li>
        <a href={`/tags/${tagSlug(tag)}/`} class="link-sweep hover:text-fg">
          #{tagSlug(tag)}
        </a>
      </li>
    ))}
  </ul>
)}
