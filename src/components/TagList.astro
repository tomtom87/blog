---
import { tagSlug } from "../lib/tags";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul
    aria-label="Tags"
    class="mt-2 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-slate-500"
  >
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tagSlug(tag)}/`}
          class="hover:text-accent hover:underline"
        >
          #{tagSlug(tag)}
        </a>
      </li>
    ))}
  </ul>
)}
