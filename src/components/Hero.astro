---
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import heroPhoto from "../assets/hero-lake-geneva.jpg";
---

<section
  aria-labelledby="hero-title"
  class="hero relative isolate flex min-h-svh overflow-hidden bg-dusk-900"
>
  <!-- Photo (slowest layer) -->
  <div class="layer photo-move" aria-hidden="true">
    <Image
      src={heroPhoto}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="photo size-full object-cover object-[50%_60%]"
    />
  </div>

  <!-- Gradient wash: dark sky behind the title, fading to the white page -->
  <div class="layer wash" aria-hidden="true"></div>

  <!-- Geometric accents (mid layer) -->
  <div class="layer shapes-move" aria-hidden="true">
    <svg class="shape s1" viewBox="0 0 100 100">
      <polygon points="50,8 94,88 6,88" />
    </svg>
    <svg class="shape s2" viewBox="0 0 100 100">
      <circle cx="50" cy="50" r="46" />
    </svg>
    <svg class="shape s3" viewBox="0 0 100 100">
      <polygon points="50,4 96,50 50,96 4,50" />
    </svg>
  </div>

  <!-- Title (fastest layer) -->
  <div class="title-move relative z-10 flex w-full">
    <div class="title mx-auto flex w-full max-w-5xl flex-col justify-center px-4 pt-24 pb-40 text-white sm:px-8">
      <p class="font-mono text-xs tracking-[0.25em] text-blue-100 uppercase sm:text-sm">
        Studio · Strategy · Build
      </p>
      <h1
        id="hero-title"
        class="mt-4 text-5xl leading-[0.95] font-light sm:text-7xl md:text-8xl"
      >
        {SITE_TITLE}
      </h1>
      <p class="mt-6 max-w-xl text-lg text-blue-50 sm:text-xl">
        Helping brands build fast, <em class="font-serif">thoughtful</em>{" "}
        websites. Replace this line with your own.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/blog/"
          class="rounded-full bg-white px-5 py-2.5 font-semibold text-dusk-900 transition hover:bg-blue-50"
        >
          Read the blog
        </a>
        <a
          href="/about/"
          class="rounded-full border border-white/50 px-5 py-2.5 font-semibold text-white backdrop-blur-sm transition hover:bg-white/10"
        >
          About me
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .layer {
    position: absolute;
    inset: 0;
  }
  .wash {
    background:
      linear-gradient(
        to bottom,
        rgb(11 30 70 / 0.85) 0%,
        rgb(11 30 70 / 0.55) 35%,
        rgb(29 78 216 / 0.1) 62%,
        rgb(255 255 255 / 0) 72%,
        #fff 100%
      ),
      radial-gradient(ellipse at 20% 30%, rgb(11 30 70 / 0.35), transparent 60%);
  }
  .title {
    text-shadow: 0 2px 24px rgb(11 30 70 / 0.45);
  }

  .shape {
    position: absolute;
    fill: none;
    stroke: #fff;
    stroke-width: 1.5;
    opacity: 0.25;
    animation: float var(--d) ease-in-out var(--delay, 0s) infinite alternate;
  }
  .s1 {
    top: 18%;
    right: 12%;
    width: 72px;
    --d: 28s;
  }
  .s2 {
    top: 52%;
    right: 26%;
    width: 120px;
    --d: 36s;
    --delay: -8s;
    opacity: 0.15;
  }
  .s3 {
    top: 30%;
    right: 40%;
    width: 40px;
    --d: 24s;
    --delay: -4s;
  }
  @keyframes float {
    to {
      transform: translate(14px, -26px) rotate(40deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shape {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes settle {
      from {
        opacity: 0;
        transform: scale(1.12);
      }
      to {
        opacity: 1;
        transform: scale(1.04);
      }
    }
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
    }
    .photo {
      animation: settle 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .title > * {
      animation: fade-up 0.9s ease-out both;
    }
    .title > :nth-child(1) {
      animation-delay: 0.4s;
    }
    .title > :nth-child(2) {
      animation-delay: 0.55s;
    }
    .title > :nth-child(3) {
      animation-delay: 0.7s;
    }
    .title > :nth-child(4) {
      animation-delay: 0.85s;
    }

    @supports (animation-timeline: scroll()) {
      @keyframes p-photo {
        to {
          transform: translateY(35vh);
        }
      }
      @keyframes p-shapes {
        to {
          transform: translateY(15vh);
        }
      }
      @keyframes p-title {
        to {
          transform: translateY(-12vh);
          opacity: 0;
        }
      }
      .photo-move,
      .shapes-move,
      .title-move {
        animation: linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .photo-move {
        animation-name: p-photo;
      }
      .shapes-move {
        animation-name: p-shapes;
      }
      .title-move {
        animation-name: p-title;
      }
    }
  }
</style>
