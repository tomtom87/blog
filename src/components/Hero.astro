---
import { Image } from "astro:assets";
import { SITE_TITLE } from "../consts";
import heroPhoto from "../assets/hero-lake-geneva.jpg";
---

<section
  aria-labelledby="hero-title"
  class="hero relative isolate flex min-h-svh overflow-hidden bg-paper"
>
  <!-- Photo (slow layer) -->
  <div class="layer photo-move" aria-hidden="true">
    <Image
      src={heroPhoto}
      alt=""
      widths={[640, 1024, 1440, 1920]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="photo size-full object-cover object-[50%_60%]"
    />
  </div>

  <!-- Gradient wash: keeps the title readable, fades into the black page -->
  <div class="layer wash" aria-hidden="true"></div>

  <!-- Title (fast layer) -->
  <div class="title-move relative z-10 flex w-full">
    <div class="title mx-auto flex w-full max-w-4xl flex-col justify-end px-4 pt-32 pb-24 sm:px-8 sm:pb-32">
      <h1
        id="hero-title"
        class="text-6xl leading-[0.88] sm:text-8xl md:text-9xl"
      >
        {SITE_TITLE}
      </h1>
      <p class="mt-6 max-w-[34ch] text-lg text-zinc-300 sm:text-xl">
        I help brands plan, design and build fast websites, and write about how
        it's done. Replace this line with your own.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a
          href="/blog/"
          class="rounded-full bg-fg px-5 py-3 font-medium text-paper transition-colors hover:bg-zinc-300"
        >
          Read the blog
        </a>
        <a
          href="/about/"
          class="rounded-full border border-zinc-600 px-5 py-3 font-medium backdrop-blur-sm transition-colors hover:bg-white/10"
        >
          About me
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .layer {
    position: absolute;
    inset: 0;
  }
  .wash {
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.55) 0%,
      rgb(0 0 0 / 0.1) 40%,
      rgb(0 0 0 / 0.45) 75%,
      #000 100%
    );
  }
  .title {
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.4);
  }

  @media (prefers-reduced-motion: no-preference) {
    @keyframes settle {
      from {
        opacity: 0;
        transform: scale(1.12);
      }
      to {
        opacity: 1;
        transform: scale(1.04);
      }
    }
    @keyframes fade-up {
      from {
        opacity: 0;
        transform: translateY(24px);
      }
    }
    .photo {
      animation: settle 1.8s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .title > * {
      animation: fade-up 0.9s ease-out both;
    }
    .title > :nth-child(1) {
      animation-delay: 0.4s;
    }
    .title > :nth-child(2) {
      animation-delay: 0.5s;
    }
    .title > :nth-child(3) {
      animation-delay: 0.65s;
    }

    @supports (animation-timeline: scroll()) {
      @keyframes p-photo {
        to {
          transform: translateY(35vh);
        }
      }
      @keyframes p-title {
        to {
          transform: translateY(-12vh);
          opacity: 0;
        }
      }
      .photo-move,
      .title-move {
        animation: linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      .photo-move {
        animation-name: p-photo;
      }
      .title-move {
        animation-name: p-title;
      }
    }
  }
</style>
